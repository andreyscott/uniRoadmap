# Copy to .env.local and fill in. Never commit real values.

# Public base URL, used for canonical links, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase Postgres via Prisma) ---
# Supabase dashboard → your project → Connect → ORMs → Prisma.
# Pooled connection (Supavisor, port 6543): used by the running app.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Direct/session connection (port 5432): used by migrations and the seed script.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Sign-in (Supabase Auth) ---
# Supabase dashboard → Project Settings → API Keys. Both are safe to expose to browsers.
# Leave them empty to run the site without sign-in (progress tracking is then hidden).
# Never put the secret key (sb_secret_...) in a NEXT_PUBLIC_ variable: the app refuses to start if you do.
# The app does not need the secret key at all.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Admin area (/admin) ---
# Comma-separated emails that are always admins. They can then give others access in /admin/people.
# Each person must have signed in once with that email.
ADMIN_EMAILS=""
