# Copy to .env.local and fill in. Never commit real values.

# Public base URL, used for canonical links, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase Postgres via Prisma) ---
# Supabase dashboard → your project → Connect → ORMs → Prisma.
# Pooled connection (Supavisor, port 6543): used by the running app.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Direct/session connection (port 5432): used by migrations and the seed script.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Added in the "auth + progress" step (Supabase Auth) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
