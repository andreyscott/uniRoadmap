// Uniroadmap database schema.
//
// General course and roadmap content is authored in /content (JSON) and copied here by
// `npm run db:seed`, so those files stay its source of truth. University data (universities,
// their versions of each course, curricula) is edited by admins in /admin, so for that the
// database is the source of truth. User data (progress, saves, quiz results) lives here too.
//
// Connection URLs live in prisma.config.ts (Prisma 7), not in this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RoadmapKind {
  DEGREE
  SKILL
}

enum NodeType {
  CORE
  ELECTIVE
  OPTIONAL_SKILL
}

enum ProgressStatus {
  DONE
  IN_PROGRESS
  SKIPPED
}

enum Role {
  STUDENT
  /// Can edit the universities listed in university_editors.
  EDITOR
  /// Can edit every university and manage editors and admins.
  ADMIN
}

enum Ownership {
  FEDERAL
  STATE
  PRIVATE
}

enum Semester {
  FIRST
  SECOND
}

enum ResourceType {
  VIDEO
  COURSE
  BOOK
  ARTICLE
  TOOL
}

/// One row per Supabase Auth user. `id` is the auth.users id, so no password data lives here.
model User {
  id             String             @id @db.Uuid
  email          String             @unique
  name           String?
  createdAt      DateTime           @default(now())
  progress       UserProgress[]
  saved          SavedRoadmap[]
  quizResults    QuizResult[]
  role           Role               @default(STUDENT)
  /// The student's own university ("My university"), if they've chosen one.
  universityId   String?
  university     University?        @relation("StudentUniversity", fields: [universityId], references: [id], onDelete: SetNull)
  editorOf       UniversityEditor[]
  edits          EditLog[]
  moduleProgress ModuleProgress[]

  @@map("users")
}

model Faculty {
  id          String   @id // slug, e.g. "engineering"
  name        String
  description String
  /// Which transit "line" colour token the UI uses for this faculty.
  color       String
  position    Int
  courses     Course[]

  @@map("faculties")
}

model Course {
  id                String             @id // slug, e.g. "computer-science"
  name              String
  facultyId         String
  faculty           Faculty            @relation(fields: [facultyId], references: [id])
  summary           String
  overview          String
  durationYears     Int
  durationNotes     String?
  difficulty        Difficulty
  /// [{ exam: "olevel" | "utme" | "alevel" | "us-highschool", subjects: string[], notes?: string }]
  entryRequirements Json
  /// [{ title, description }]
  careers           Json
  /// Quiz-matching weights, e.g. { "maths": 3, "helping-people": 1 }
  tagProfile        Json
  roadmap           Roadmap?
  offerings         UniversityCourse[]
  updatedAt         DateTime           @updatedAt

  @@index([facultyId])
  @@map("courses")
}

model Roadmap {
  id          String         @id // same slug as the course, or the skill roadmap slug
  kind        RoadmapKind
  title       String
  description String
  /// Stage headings in order, e.g. [{ stage: 1, title: "Year 1", summary }]
  stages      Json
  courseId    String?        @unique // null for skill roadmaps
  course      Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  nodes       RoadmapNode[]
  saves       SavedRoadmap[]
  updatedAt   DateTime       @updatedAt

  @@index([kind])
  @@map("roadmaps")
}

model RoadmapNode {
  /// Stable, globally unique id (e.g. "cs-y1-discrete-math"). Never rename: progress points here.
  id          String             @id
  roadmapId   String
  roadmap     Roadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  /// The topic this one builds on, drawn as a connector in the roadmap view.
  parentId    String?
  parent      RoadmapNode?       @relation("NodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    RoadmapNode[]      @relation("NodeTree")
  title       String
  description String
  keyConcepts String[]
  type        NodeType
  stage       Int // year number for degrees, step number for skill roadmaps
  position    Int // order within the stage
  resources   Resource[]
  progress    UserProgress[]
  modules     UniversityModule[]

  @@index([roadmapId, stage, position])
  @@index([parentId])
  @@map("roadmap_nodes")
}

model Resource {
  id       String       @id @default(cuid())
  nodeId   String
  node     RoadmapNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  title    String
  url      String
  type     ResourceType
  free     Boolean      @default(true)
  position Int

  @@index([nodeId])
  @@map("resources")
}

model UserProgress {
  userId    String         @db.Uuid
  nodeId    String
  status    ProgressStatus
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  node      RoadmapNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@index([nodeId])
  @@map("user_progress")
}

model SavedRoadmap {
  userId    String   @db.Uuid
  roadmapId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@id([userId, roadmapId])
  @@index([roadmapId])
  @@map("saved_roadmaps")
}

/// Copied from content/quiz.json by the seed script.
model QuizQuestion {
  id         String  @id
  position   Int
  prompt     String
  /// Hint shown under the question.
  help       String?
  /// "single" (pick one) or "multi" (pick up to maxChoices).
  kind       String  @default("single")
  maxChoices Int?
  /// [{ id, label, weights?: { tag: 1-3 }, exam?, maxYears?, maxDifficulty? }]
  options    Json

  @@map("quiz_questions")
}

model QuizResult {
  id         String   @id @default(cuid())
  userId     String?  @db.Uuid // null for anonymous results (shareable by link)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// { questionId: optionId[] }
  answers    Json
  /// [{ courseId, score, reasons: string[] }]
  topCourses Json
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("quiz_results")
}

/// A university. The starter list comes from content/universities.json; after that, admins
/// edit universities in /admin and the seed never overwrites them.
model University {
  id          String             @id // slug, e.g. "uniben"
  name        String
  shortName   String
  city        String
  state       String
  ownership   Ownership
  website     String?
  description String?
  courses     UniversityCourse[]
  editors     UniversityEditor[]
  students    User[]             @relation("StudentUniversity")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("universities")
}

/// A general course as taught at one university: that school's details and curriculum.
model UniversityCourse {
  id             String             @id @default(cuid())
  universityId   String
  university     University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  department     String?
  faculty        String?
  /// Only when it differs from the general course.
  durationYears  Int?
  /// The school's UTME subject combination, in its own wording.
  utmeSubjects   String[]
  /// Cut-off marks, post-UTME screening and other admission notes.
  admissionNotes String?
  notes          String?
  modules        UniversityModule[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([universityId, courseId])
  @@index([courseId])
  @@map("university_courses")
}

/// One module in a university's curriculum, e.g. "CSC 211 Data Structures, 3 units, first semester".
model UniversityModule {
  id                 String           @id @default(cuid())
  universityCourseId String
  universityCourse   UniversityCourse @relation(fields: [universityCourseId], references: [id], onDelete: Cascade)
  code               String
  title              String
  year               Int
  /// Null for a module that runs all year, such as industrial training.
  semester           Semester?
  creditUnits        Int?
  type               NodeType         @default(CORE)
  description        String?
  /// The general roadmap topic it covers; that topic's explanation and free resources show too.
  topicId            String?
  topic              RoadmapNode?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  position           Int              @default(0)
  progress           ModuleProgress[]

  @@index([universityCourseId, year, semester, position])
  @@index([topicId])
  @@map("university_modules")
}

/// A student's progress on a university module (general topics use user_progress).
model ModuleProgress {
  userId    String           @db.Uuid
  moduleId  String
  status    ProgressStatus
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    UniversityModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@index([moduleId])
  @@map("module_progress")
}

/// Which universities an EDITOR may change. Admins may change all of them.
model UniversityEditor {
  userId       String     @db.Uuid
  universityId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@id([userId, universityId])
  @@index([universityId])
  @@map("university_editors")
}

/// Every change made in /admin, with before/after snapshots so it can be reviewed and undone.
model EditLog {
  id           String    @id @default(cuid())
  userId       String?   @db.Uuid
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Plain text, not a foreign key, so history survives the university being deleted.
  universityId String?
  /// "university" | "universityCourse" | "module" | "editor" | "role"
  entity       String
  entityId     String
  /// "create" | "update" | "delete"
  action       String
  summary      String
  before       Json?
  after        Json?
  undoneAt     DateTime?
  undoneById   String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([universityId, createdAt])
  @@index([entity, entityId, createdAt])
  @@map("edit_log")
}
